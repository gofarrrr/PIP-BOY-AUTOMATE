# OpenRouter API Key (required for the chatbot)
# Get your key at: https://openrouter.ai/keys

# For LOCAL DEVELOPMENT (Vite injects this into the browser - OK for dev only)
VITE_OPENROUTER_API_KEY=sk-or-your-key-here

# For PRODUCTION (Vercel) - use the non-VITE version in Vercel dashboard
# This keeps the key server-side and hidden from the browser
# OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: Change the LLM model
# VITE_LLM_MODEL=google/gemini-2.0-flash-exp:free
# LLM_MODEL=google/gemini-2.0-flash-exp:free
